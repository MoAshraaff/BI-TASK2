# .env holds the local SQL Server sa password used by docker-compose.
# Local dev credential, but still a credential - keep it out of the repo.
.env

# Build output / dependencies - all reproducible.
node_modules/
dist/
.angular/
bin/
obj/

# Packages/ is deliberately NOT ignored: the SalesBuzz npm .tgz files and the
# BI-SDK .nupkg are not on any public registry, so the repo is the only place
# they exist. Removing them breaks every install path, host and container.
