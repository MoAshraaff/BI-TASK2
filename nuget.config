<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet config. Without this, BI-SDK only resolves via a NuGet
  source registered machine-wide in %APPDATA%\NuGet\NuGet.Config (see
  CLAUDE.md) - which a Docker build has no access to. The relative path
  below is resolved against this file's own directory, so `dotnet restore`
  finds BI-SDK identically on the host, in a fresh checkout, or in a
  container, with no machine-level setup step.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-bi-sdk" value="./Packages/nuget" />
  </packageSources>
</configuration>
