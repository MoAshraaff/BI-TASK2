# Build context here is the repo root (see docker-compose.yml's `context: .`),
# so this is the only .dockerignore Docker actually reads - per-subfolder
# .dockerignore files are silently ignored by the default build context.
app/node_modules/
app/dist/
app/.angular/

api/bin/
api/obj/

Packages/nuget/*.nuspec
.git/
