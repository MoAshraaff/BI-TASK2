<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet source for the proprietary BI-SDK package (see
     CLAUDE.md "Package provenance"). Lets `dotnet restore` work from a
     plain checkout - including inside the Docker build - without needing
     the machine-level %APPDATA%\NuGet\NuGet.Config entry this project
     otherwise relies on. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-bi-sdk" value="../Packages/nuget" />
  </packageSources>
</configuration>
